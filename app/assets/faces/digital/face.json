{
  "id": "digital",
  "name": "Digital",
  "author": "echoclock",
  "description": "Big digital clock with optional seconds, date, next alarm, weather and next event.",
  "settings": [
    { "key": "format24h", "label": "24-hour clock", "type": "bool", "default": false },
    { "key": "showSeconds", "label": "Seconds", "type": "bool", "default": false },
    { "key": "showDate", "label": "Date", "type": "bool", "default": true },
    { "key": "showNextAlarm", "label": "Next alarm", "type": "bool", "default": true },
    { "key": "alarmDay", "label": "Alarm day (e.g. Tue)", "type": "bool", "default": true },
    { "key": "showNextEvent", "label": "Next event", "type": "bool", "default": true },
    { "key": "showWeather", "label": "Weather", "type": "bool", "default": true },
    { "key": "tempUnit", "label": "Temperature unit", "type": "enum", "options": ["F", "C"], "default": "F" },
    { "key": "accent", "label": "Accent color", "type": "color", "default": "#4fd6ff" }
  ]
}

# shellcheck shell=bash
# EchoClock installer configuration — single source of truth for versions/URLs/checksums.
# Sourced by install/*.sh. Override any value from the environment before running.

# ---- target device ---------------------------------------------------------
CODENAME="cronos"                 # Echo Show 5 (2nd gen, 2021)

# ---- LineageOS 18.1 ROM (Android 11) --------------------------------------
# ROM_TAG is part of the release download URL (see ROM_URL).
ROM_TAG="lineage-18.1-cronos-v0.4"
ROM_FILE="lineage-18.1-20260904-UNOFFICIAL-cronos.zip"
ROM_URL="https://github.com/amazon-oss/releases/releases/download/${ROM_TAG}/${ROM_FILE}"
ROM_SHA256="4c355998061a454792128d4b730932b47ed05a3d2a6d2628599218f44cc84678"

# ---- GApps (MindTheGapps, 32-bit ARM — cronos userspace is armeabi-v7a) ----
GAPPS_FILE="MindTheGapps-11.0.0-arm-20230922_081034.zip"
GAPPS_URL="https://github.com/MindTheGapps/11.0.0-arm/releases/download/MindTheGapps-11.0.0-arm-20230922_081034/${GAPPS_FILE}"
GAPPS_SHA256="cd54071df4ccd43e1c290b57508a003d253a20f23e59bba1f3d90c5fc6ad1dd0"

# ---- amonet bootloader-unlock bundle (XDA attachment; manual download) -----
# The bundle is only distributed via the XDA thread (login-gated), so download.sh cannot
# fetch it automatically. Place it in install/dl/ with this exact name.
AMONET_FILE="amonet-cronos-v2.0.1.zip"
AMONET_PAGE="https://xdaforums.com/t/unlock-root-twrp-unbrick-amazon-echo-show-5-2nd-gen-2021-cronos.4772596/"
AMONET_SHA256=""

# ---- bundled third-party APKs (optional) -----------------------------------
# Space-separated basenames under apps/ to install during provision.sh, e.g.
# BUNDLED_APKS="plexamp.apk Caustic_3.2.2_64b.apk". apps/ holds personal APKs and is
# gitignored (never published); empty by default.
BUNDLED_APKS=""

# ---- on-device paths -------------------------------------------------------
DEVICE_APP_DIR="/sdcard/EchoClock"
LAUNCHER_COMPONENT="org.echoclock/.HomeActivity"
APK_NAME="EchoClock.apk"
